<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>it.univaq.unigest</groupId>
    <artifactId>untitled</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versioni parametrizzate delle dipendenze adoperate -->
        <com.google.code.gson.version>2.10.1</com.google.code.gson.version>
        <javafx.version>23</javafx.version>
        <org.apache.commons.version>1.27.1</org.apache.commons.version>
        <org.apache.commons-lang3.version>3.18.0</org.apache.commons-lang3.version>
        <log4j.version>2.23.1</log4j.version>
        <librepdf.version>2.2.4</librepdf.version>

    </properties>

    <dependencies>
        <!-- Helper file JSON di google -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${com.google.code.gson.version}</version>
        </dependency>

        <!-- JavaFX con classifier per macOS ARM -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>mac-aarch64</classifier>
        </dependency>

        <!-- JavaFX con classifier per macOS ARM -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
            <classifier>mac-aarch64</classifier>
        </dependency>

        <!-- Gestore di archivi (zip, etc) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${org.apache.commons.version}</version>
        </dependency>

        <!-- Adoperata come dipendenza transitiva di org.apache.commons in modo da averla aggiornata e sicura, senza warning -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${org.apache.commons-lang3.version}</version>
        </dependency>

        <!-- Libre PDF per esportazione e generazione di report in PDF -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${librepdf.version}</version>
        </dependency>

        <!-- Framework Logging -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <dependency>
            <groupId>net.sourceforge.plantuml</groupId>
            <artifactId>plantuml</artifactId>
            <version>1.2025.4</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>it.univaq.unigest.gui.Main</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <failOnError>false</failOnError>
                    <additionalJOption>-Xdoclint:none</additionalJOption>
                </configuration>
            </plugin>

            <!--Generatore PlantUML-->
            <plugin>
                <groupId>de.elnarion.maven</groupId>
                <artifactId>plantuml-generator-maven-plugin</artifactId>
                <version>3.0.1</version>

                <executions>
                    <!--Dominio: model + repository + service -->
                    <execution>
                        <id>generate-uml-domain</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/docs/uml</outputDirectory>
                            <outputFilename>unigest-domain.puml</outputFilename>

                            <scanPackages>
                                <scanPackage>it.univaq.unigest.model</scanPackage>
                                <scanPackage>it.univaq.unigest.repository</scanPackage>
                                <scanPackage>it.univaq.unigest.service</scanPackage>
                            </scanPackages>
                            <useShortClassNamesInFieldsAndMethods>true</useShortClassNamesInFieldsAndMethods>
                        </configuration>
                    </execution>

                    <!--Utility: util + util.backup -->
                    <execution>
                        <id>generate-uml-util</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/docs/uml</outputDirectory>
                            <outputFilename>unigest-util.puml</outputFilename>

                            <scanPackages>
                                <scanPackage>it.univaq.unigest.util</scanPackage>
                                <scanPackage>it.univaq.unigest.util.backup</scanPackage>
                            </scanPackages>

                            <useShortClassNamesInFieldsAndMethods>true</useShortClassNamesInFieldsAndMethods>
                        </configuration>
                    </execution>

                    <!--GUI -->
                    <execution>
                      <id>generate-uml-gui</id>
                      <phase>process-classes</phase>
                      <goals><goal>generate</goal></goals>
                      <configuration>
                        <outputDirectory>${project.basedir}/docs/uml</outputDirectory>
                        <outputFilename>unigest-gui.puml</outputFilename>
                        <scanPackages>
                          <scanPackage>it.univaq.unigest.gui</scanPackage>
                        </scanPackages>
                        <useShortClassNamesInFieldsAndMethods>true</useShortClassNamesInFieldsAndMethods>
                        <blacklistRegexp>.*(icons|css|componenti).*</blacklistRegexp>
                      </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>render-puml-to-svg</id>
                        <phase>prepare-package</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>net.sourceforge.plantuml.Run</mainClass>
                            <arguments>
                                <argument>-tsvg</argument>
                                <argument>-nometadata</argument>
                                <!-- directory dove stanno i .puml -->
                                <argument>${project.basedir}/docs/uml</argument>
                            </arguments>
                            <includeProjectDependencies>true</includeProjectDependencies>
                            <classpathScope>runtime</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


        </plugins>
    </build>


</project>